{
  "name": "@halo-pulse/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:assets": "node scripts/fetch-mediapipe-assets.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "copy:dl-spike": "node scripts/copy-dl-spike-assets.mjs",
    "dev": "node scripts/build-worker.mjs && node scripts/generate-icons.mjs && node scripts/copy-dl-spike-assets.mjs && vite",
    "build": "node scripts/build-worker.mjs && node scripts/generate-icons.mjs && node scripts/copy-dl-spike-assets.mjs && pnpm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/worker/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@halo-pulse/dsp": "workspace:*",
    "@halo-pulse/types": "workspace:*",
    "@halo-pulse/vision": "workspace:*",
    "@mediapipe/tasks-vision": "^0.10.35",
    "dexie": "^4.4.4",
    "onnxruntime-web": "^1.27.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.5",
    "vite": "^8.1.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
