{
  "name": "@halo-pulse/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:assets": "node scripts/fetch-mediapipe-assets.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "dev": "node scripts/build-worker.mjs && vite",
    "build": "node scripts/build-worker.mjs && pnpm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/worker/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@halo-pulse/dsp": "workspace:*",
    "@halo-pulse/types": "workspace:*",
    "@halo-pulse/vision": "workspace:*",
    "@mediapipe/tasks-vision": "^0.10.35",
    "dexie": "^4.4.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.5",
    "vite": "^8.1.3"
  }
}
